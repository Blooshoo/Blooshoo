# BunnyCDN
BUNNYCDN_STORAGE_ZONE_NAME=your-storage-zone
BUNNYCDN_STORAGE_API_KEY=your-storage-api-key
BUNNYCDN_PULL_ZONE_URL=https://your-zone.b-cdn.net
BUNNYCDN_STORAGE_REGION=de   # de, ny, la, sg, syd

# DeepSeek API (direct)
DEEPSEEK_API_KEY=your-deepseek-api-key

# Admin Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your-bcrypt-hash

# Auth — better-auth
AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://blooshoo.com
BETTER_AUTH_TRUSTED_ORIGINS=https://blooshoo.com,http://192.168.0.124:7777
