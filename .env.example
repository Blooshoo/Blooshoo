# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` or real secrets.
#
# Generate a strong auth secret with:
#   openssl rand -base64 32
#
# POSTGRES_PASSWORD: any strong password (e.g. `openssl rand -base64 24`).
# If this DB password was ever deployed with the old default
# ("blooshoo"), that password is burned — rotate it.
#
# Discord OAuth: create an app at https://discord.com/developers/applications
#   - OAuth2 redirect URL: <BETTER_AUTH_URL>/api/auth/callback/discord
#   - ALLOWED_DISCORD_IDS: optional comma-separated bootstrap IDs. They are
#     copied into the database allowlist on the first auth request; after that,
#     manage access from the owner-only Users panel.

AUTH_SECRET=replace-with-openssl-rand-base64-32-output
POSTGRES_PASSWORD=replace-with-a-strong-password

# Optional — defaults match local development
BETTER_AUTH_URL=http://localhost:7777
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:7777
ORIGIN=http://localhost:7777
HOST_BIND=127.0.0.1
HOST_PORT=7777

# Discord OAuth (required for sign-in)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ALLOWED_DISCORD_IDS=

# BunnyCDN (optional — media uploads)
BUNNY_CDN_URL=
BUNNY_STORAGE_HOSTNAME=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_ZONE=
